@* Sticky page header: breadcrumb title, sync pill, page actions. *@
<header class="d-topbar pf-top">
    <span class="crumbs">
        <span>Финансы</span><span class="sep">/</span><h1 class="current" tabindex="-1">@Title</h1>
    </span>
    @Meta
    <span class="pf-top-spacer"></span>
    <SyncBadge />
    @ChildContent
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Inline content next to the title (e.g. the total balance).</summary>
    [Parameter] public RenderFragment? Meta { get; set; }

    /// <summary>Page actions on the right.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
