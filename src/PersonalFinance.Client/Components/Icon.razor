@* Renders a symbol from the inline sprite in index.html (ids are "i-{Name}"). *@
<svg class="@Class" style="@Style" aria-hidden="true"><use href="#i-@Name"></use></svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    [Parameter] public string? Class { get; set; } = "i";

    [Parameter] public string? Style { get; set; }
}
