@inherits LayoutComponentBase
@implements IDisposable
@using PersonalFinance.Client.Services
@using PersonalFinance.Client.Formatting
@using PersonalFinance.Domain.Entities
@inject NavigationManager Navigation
@inject TransactionDialogService DialogService
@inject LocalAccountService AccountService
@inject LocalCategoryService CategoryService
@inject PreferencesService Preferences

<AuthorizeView>
    <Authorized>
        <div class="app-shell">
            <nav class="app-sidebar">
                <div class="auth-brand" style="margin-bottom:6px;padding:4px 8px 0"><span class="brand-mark">PF</span>Финансы</div>
                <NavLink class="sidebar-item" href="dashboard"><i class="ph ph-squares-four"></i>Обзор</NavLink>
                <NavLink class="sidebar-item" href="transactions"><i class="ph ph-list-dashes"></i>Операции</NavLink>
                <NavLink class="sidebar-item" href="accounts"><i class="ph ph-wallet"></i>Счета</NavLink>
                <NavLink class="sidebar-item" href="categories"><i class="ph ph-tag"></i>Категории</NavLink>
                <NavLink class="sidebar-item" href="reports"><i class="ph ph-chart-donut"></i>Отчёты</NavLink>
                <NavLink class="sidebar-item" href="settings"><i class="ph ph-gear-six"></i>Настройки</NavLink>
                <button type="button" class="sidebar-footer" @onclick="GoToSettings">
                    <span class="avatar">@Format.Initials(context.User.Identity?.Name ?? "?")</span>
                    <span>@context.User.Identity?.Name</span>
                </button>
            </nav>

            <div class="mobile-topbar">
                <span class="brand-mark">PF</span>
                <SyncStatusChip />
                <button type="button" class="avatar" style="margin-left:auto;border:none;cursor:pointer" @onclick="GoToSettings">@Format.Initials(context.User.Identity?.Name ?? "?")</button>
            </div>

            <main class="app-main">
                @Body
            </main>

            <button type="button" class="fab" @onclick="DialogService.OpenNew" aria-label="Новая операция"><i class="ph ph-plus"></i></button>

            <nav class="bottom-nav">
                <NavLink class="bottom-nav-item" href="dashboard"><i class="ph ph-squares-four"></i>Обзор</NavLink>
                <NavLink class="bottom-nav-item" href="transactions"><i class="ph ph-list-dashes"></i>Операции</NavLink>
                <NavLink class="bottom-nav-item" href="accounts"><i class="ph ph-wallet"></i>Счета</NavLink>
                <NavLink class="bottom-nav-item" href="reports"><i class="ph ph-chart-donut"></i>Отчёты</NavLink>
                <NavLink class="bottom-nav-item" href="settings"><i class="ph ph-gear-six"></i>Ещё</NavLink>
            </nav>
        </div>

        <TransactionEditor IsOpen="DialogService.IsOpen"
                            EditingTransaction="DialogService.Editing"
                            StartAsTransfer="DialogService.OpenAsTransfer"
                            Accounts="_accounts"
                            Categories="_categories"
                            DefaultAccountId="_defaultAccountId"
                            OnClose="DialogService.Close"
                            OnSaved="DialogService.NotifySaved" />
    </Authorized>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<Account> _accounts = new();
    private List<Category> _categories = new();
    private Guid? _defaultAccountId;

    protected override async Task OnInitializedAsync()
    {
        DialogService.Changed += OnDialogChanged;
        await ReloadReferenceDataAsync();
    }

    private void OnDialogChanged() => InvokeAsync(async () =>
    {
        if (DialogService.IsOpen)
        {
            await ReloadReferenceDataAsync();
            _defaultAccountId = await Preferences.GetDefaultAccountIdAsync();
        }

        StateHasChanged();
    });

    private async Task ReloadReferenceDataAsync()
    {
        _accounts = await AccountService.GetAllAsync();
        _categories = await CategoryService.GetAllAsync();
    }

    private void GoToSettings() => Navigation.NavigateTo("settings");

    public void Dispose()
    {
        DialogService.Changed -= OnDialogChanged;
    }
}
