@inherits LayoutComponentBase
@using System.Security.Claims
@using PersonalFinance.Client.Sync
@implements IDisposable
@inject AppState AppState
@inject SyncService Sync

<AuthorizeView>
    <Authorized>
        <div class="shell">
            <aside class="d-sidebar">
                <div class="brand">
                    <span class="brand-logo"><svg viewBox="0 0 36 36"><use href="#i-logo"></use></svg></span>
                    <span class="brand-text">
                        <span class="brand-name" style="display:block">Финансы</span>
                        <span class="brand-tag">PERSONAL</span>
                    </span>
                </div>
                <nav class="nav-section">
                    <span class="nav-label">Меню</span>
                    <NavLink class="nav-link" ActiveClass="is-active" href="" Match="NavLinkMatch.All"><Icon Name="grid" Class="@null" /><span>Обзор</span></NavLink>
                    <NavLink class="nav-link" ActiveClass="is-active" href="transactions">
                        <Icon Name="list" Class="@null" /><span>Операции</span>
                        @if (Sync.PendingCount > 0)
                        {
                            <span class="nav-badge new" title="Изменений в очереди на отправку">@Sync.PendingCount</span>
                        }
                    </NavLink>
                    <NavLink class="nav-link" ActiveClass="is-active" href="accounts"><Icon Name="wallet" Class="@null" /><span>Счета</span></NavLink>
                    <NavLink class="nav-link" ActiveClass="is-active" href="categories"><Icon Name="tag" Class="@null" /><span>Категории</span></NavLink>
                    <NavLink class="nav-link" ActiveClass="is-active" href="reports"><Icon Name="chart" Class="@null" /><span>Отчёты</span></NavLink>
                    <NavLink class="nav-link" ActiveClass="is-active" href="settings"><Icon Name="gear" Class="@null" /><span>Настройки</span></NavLink>
                </nav>
                <div class="sidebar-footer">
                    <a class="workspace" href="settings">
                        <span class="workspace-avatar">@Fmt.Initials(context.User.Identity?.Name)</span>
                        <span class="workspace-text">
                            <span class="workspace-name" style="display:block">@context.User.Identity?.Name</span>
                            <span class="workspace-role">@context.User.FindFirst(ClaimTypes.Email)?.Value</span>
                        </span>
                    </a>
                </div>
            </aside>
            <main class="main">
                @Body
            </main>
        </div>

        <button type="button" class="btn btn--primary pf-fab" aria-label="Новая операция" @onclick="() => AppState.OpenTransactionEditor()">
            <Icon Name="plus" />
        </button>
        <nav class="pf-tabbar" aria-label="Разделы">
            <NavLink class="pf-tab" ActiveClass="is-active" href="" Match="NavLinkMatch.All"><Icon Name="grid" />Обзор</NavLink>
            <NavLink class="pf-tab" ActiveClass="is-active" href="transactions"><Icon Name="list" />Операции</NavLink>
            <NavLink class="pf-tab" ActiveClass="is-active" href="accounts"><Icon Name="wallet" />Счета</NavLink>
            <NavLink class="pf-tab" ActiveClass="is-active" href="reports"><Icon Name="chart" />Отчёты</NavLink>
            <NavLink class="pf-tab" ActiveClass="is-active" href="settings"><Icon Name="dots" />Ещё</NavLink>
        </nav>

        <TransactionEditor />
    </Authorized>
    <NotAuthorized>
        <main class="pf-auth">
            @Body
        </main>
    </NotAuthorized>
</AuthorizeView>

@code {
    protected override void OnInitialized() => Sync.StateChanged += OnSyncStateChanged;

    private void OnSyncStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Sync.StateChanged -= OnSyncStateChanged;
}
