<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToHome />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Не найдено · Финансы</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="pf-body" style="width:100%;max-width:640px;margin:0 auto">
                    <EmptyState IconName="alert" Title="Такой страницы нет" Text="Возможно, ссылка устарела.">
                        <a class="btn btn--primary" href="">На главную</a>
                    </EmptyState>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
