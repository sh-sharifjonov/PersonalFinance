@page "/login"
@using PersonalFinance.Client.Auth
@using PersonalFinance.Client.Sync
@inject AuthService AuthService
@inject SyncService SyncService
@inject NavigationManager Navigation

<PageTitle>Log in</PageTitle>

<h1>Log in</h1>

<EditForm Model="_model" OnValidSubmit="LoginAsync">
    <input @bind="_model.Email" placeholder="Email" type="email" />
    <input @bind="_model.Password" placeholder="Password" type="password" />
    <button type="submit" disabled="@_isBusy">Log in</button>
</EditForm>

@if (_error is not null)
{
    <p style="color:red">@_error</p>
}

@code {
    private readonly LoginModel _model = new();
    private string? _error;
    private bool _isBusy;

    private async Task LoginAsync()
    {
        _isBusy = true;
        _error = null;

        var result = await AuthService.LoginAsync(_model.Email, _model.Password);

        if (!result.Success)
        {
            _error = result.Error;
            _isBusy = false;
            return;
        }

        _ = SyncService.SyncAsync();
        Navigation.NavigateTo("/accounts");
    }

    private class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
