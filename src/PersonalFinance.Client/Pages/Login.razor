@page "/login"
@using PersonalFinance.Client.Auth
@using PersonalFinance.Client.Sync
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject SyncService SyncService
@inject NavigationManager Navigation

<PageTitle>Вход · Финансы</PageTitle>

<div class="card pf-auth-card">
    <div class="pf-auth-brand">
        <span class="brand-logo"><svg viewBox="0 0 36 36"><use href="#i-logo"></use></svg></span>
        <span class="brand-name">Финансы</span>
    </div>
    <div>
        <h1 class="pf-h" style="font-size:24px" tabindex="-1">Вход</h1>
        <div class="field-help" style="font-size:13px;margin-top:4px">Данные хранятся на устройстве и синхронизируются при появлении сети.</div>
    </div>

    <EditForm Model="_model" OnSubmit="LoginAsync" style="display:flex;flex-direction:column;gap:16px">
        <div class="field">
            <label class="field-label" for="email">Email</label>
            <input id="email" class="input" type="email" autocomplete="email" required @bind="_model.Email" />
        </div>
        <div class="field">
            <label class="field-label" for="password">Пароль</label>
            <input id="password" class="input" type="password" autocomplete="current-password" required @bind="_model.Password" />
        </div>

        @if (_error is not null)
        {
            <div class="pf-alert" role="alert"><Icon Name="alert" />@_error</div>
        }

        <button type="submit" class="btn btn--primary btn--block" style="padding:11px" disabled="@_isBusy">
            @(_isBusy ? "Входим…" : "Войти")
        </button>
    </EditForm>

    <div class="pf-auth-foot">Нет аккаунта? <a href="register">Создать</a></div>
</div>

@code {
    private readonly LoginModel _model = new();
    private string? _error;
    private bool _isBusy;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated ?? false)
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task LoginAsync()
    {
        _isBusy = true;
        _error = null;

        LoginResult result;
        try
        {
            result = await AuthService.LoginAsync(_model.Email, _model.Password);
        }
        catch (HttpRequestException)
        {
            result = new LoginResult(false, "Сервер недоступен. Для входа нужна сеть.");
        }

        if (!result.Success)
        {
            _error = result.Error;
            _isBusy = false;
            return;
        }

        _ = SyncService.SyncAsync();
        Navigation.NavigateTo("/");
    }

    private class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
