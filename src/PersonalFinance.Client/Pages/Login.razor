@page "/login"
@implements IDisposable
@using PersonalFinance.Client.Auth
@using PersonalFinance.Client.Sync
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject SyncService SyncService
@inject ConnectivityService Connectivity
@inject NavigationManager Navigation

<PageTitle>Вход</PageTitle>

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-brand"><span class="brand-mark">PF</span>Финансы</div>
        <h3>Вход</h3>
        <p class="text-muted" style="font-size:13px;margin-bottom:var(--space-6)">
            Данные хранятся на устройстве и синхронизируются, когда появится сеть.
        </p>

        <EditForm Model="_model" OnValidSubmit="LoginAsync">
            <div class="field" style="margin-bottom:14px">
                <label>Email</label>
                <input class="input" type="email" @bind="_model.Email" required />
            </div>
            <div class="field">
                <label>Пароль</label>
                <input class="input" type="password" @bind="_model.Password" required />
            </div>

            @if (_error is not null)
            {
                <div class="validation-message" style="margin-top:10px">@_error</div>
            }

            @if (!Connectivity.IsOnline)
            {
                <div class="validation-message" style="margin-top:10px">Нет сети — вход недоступен, пока не восстановится соединение.</div>
            }

            <button type="submit" class="btn btn-primary btn-block" style="margin-top:22px;padding-block:9px" disabled="@(_isBusy || !Connectivity.IsOnline)">
                @if (_isBusy)
                {
                    <i class="ph ph-spinner spin"></i>
                }
                Войти
            </button>
        </EditForm>

        <div style="font-size:12.5px;color:color-mix(in srgb, var(--color-text) 55%, transparent);margin-top:18px;text-align:center">
            Нет аккаунта? <a href="register">Создать</a>
        </div>

        @if (!Connectivity.IsOnline)
        {
            <span class="chip" style="margin:26px auto 0"><i class="ph ph-wifi-slash"></i>Офлайн</span>
        }
    </div>
</div>

@code {
    private readonly LoginModel _model = new();
    private string? _error;
    private bool _isBusy;

    protected override async Task OnInitializedAsync()
    {
        Connectivity.OnlineStatusChanged += OnConnectivityChanged;

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated ?? false)
        {
            Navigation.NavigateTo("/dashboard");
        }
    }

    private void OnConnectivityChanged(bool _) => InvokeAsync(StateHasChanged);

    public void Dispose() => Connectivity.OnlineStatusChanged -= OnConnectivityChanged;

    private async Task LoginAsync()
    {
        _isBusy = true;
        _error = null;

        var result = await AuthService.LoginAsync(_model.Email, _model.Password);

        if (!result.Success)
        {
            _error = result.Error;
            _isBusy = false;
            return;
        }

        _ = SyncService.SyncAsync();
        Navigation.NavigateTo("/dashboard");
    }

    private class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
