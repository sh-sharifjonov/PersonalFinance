@page "/transactions"
@attribute [Authorize]
@implements IDisposable
@using PersonalFinance.Client.Services
@using PersonalFinance.Client.Sync
@using PersonalFinance.Client.Formatting
@using PersonalFinance.Domain.Entities
@using PersonalFinance.Domain.Enums
@inject LocalTransactionService TransactionService
@inject LocalAccountService AccountService
@inject LocalCategoryService CategoryService
@inject OutboxService Outbox
@inject TransactionDialogService DialogService

<PageTitle>Операции</PageTitle>

<div class="page-top">
    <h4>Операции</h4>
    <SyncStatusChip />
    <button type="button" class="btn btn-primary hide-on-mobile" @onclick="DialogService.OpenNew"><i class="ph ph-plus"></i>Новая операция</button>
</div>

@if (!_loaded)
{
    <p class="text-muted">Загрузка…</p>
}
else if (_accounts.Count == 0)
{
    <div class="empty-state"><p class="text-muted">Добавьте <a href="accounts">счёт</a>, чтобы начать вести операции.</p></div>
}
else if (_categories.Count == 0)
{
    <div class="empty-state"><p class="text-muted">Добавьте <a href="categories">категорию</a>, чтобы начать вести операции.</p></div>
}
else
{
    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
        <div class="field" style="width:230px"><input class="input" placeholder="Поиск по заметкам" @bind="_search" @bind:event="oninput" /></div>
        <div class="seg">
            <label class="seg-opt"><input type="radio" name="txn-filter" checked="@(_typeFilter is null)" @onchange="() => SetTypeFilter(null)" /><span>Все</span></label>
            <label class="seg-opt"><input type="radio" name="txn-filter" checked="@(_typeFilter == TransactionType.Expense)" @onchange="() => SetTypeFilter(TransactionType.Expense)" /><span>Расходы</span></label>
            <label class="seg-opt"><input type="radio" name="txn-filter" checked="@(_typeFilter == TransactionType.Income)" @onchange="() => SetTypeFilter(TransactionType.Income)" /><span>Доходы</span></label>
        </div>
        <select class="input" style="width:auto" @bind="_accountFilterValue">
            <option value="">Все счета</option>
            @foreach (var account in _accounts)
            {
                <option value="@account.Id">@account.Name</option>
            }
        </select>
        <select class="input" style="width:auto" @bind="_monthFilterValue">
            <option value="">Все месяцы</option>
            @foreach (var (key, label) in AvailableMonths)
            {
                <option value="@key">@label</option>
            }
        </select>
        <span class="text-muted" style="margin-left:auto;font-size:12px">
            @FilteredList.Count @Format.Plural(FilteredList.Count, "операция", "операции", "операций") · итог <span class="num">@(FilteredTotal >= 0 ? "+" : "")@Format.Money(FilteredTotal)</span>
        </span>
    </div>

    @if (FilteredList.Count == 0)
    {
        <div class="empty-state">
            <span class="icon-tile" style="width:48px;height:48px;font-size:22px"><i class="ph ph-receipt"></i></span>
            <div style="font-size:16px">Ничего не найдено</div>
            <p class="text-muted">Измените фильтры или добавьте первую операцию.</p>
        </div>
    }
    else
    {
        <div>
            @foreach (var group in VisibleList.GroupBy(t => t.Date).OrderByDescending(g => g.Key))
            {
                <div class="txn-day-heading">
                    <span>@ToUpperFirst(Format.DayMonthWeekday(group.Key))</span>
                    <span class="num">@(DaySignedTotal(group) >= 0 ? "+" : "")@Format.Money(DaySignedTotal(group))</span>
                </div>
                @foreach (var t in group.OrderByDescending(t => t.CreatedAt))
                {
                    <div class="txn-row" style="cursor:pointer" @onclick="() => DialogService.OpenEdit(t)">
                        <span class="icon-tile"><i class="ph ph-@Format.CategoryIcon(CategoryOf(t)?.Icon)"></i></span>
                        <span><span class="txn-title">@TransactionTitle(t)</span><br><span class="txn-meta">@CategoryName(t.CategoryId) · @AccountName(t.AccountId)</span></span>
                        <span style="display:flex;align-items:center;gap:10px">
                            @if (IsPending(t.Id))
                            {
                                <span class="chip"><i class="ph ph-clock-countdown"></i>ожидает</span>
                            }
                            <span class="num @(t.Type == TransactionType.Income ? "amount-in" : "amount-out")" style="font-size:14px">@Format.SignedAmount(t.Amount, t.Type)</span>
                            <button type="button" class="btn btn-icon btn-ghost" title="Удалить" @onclick="() => DeleteAsync(t.Id)" @onclick:stopPropagation="true"><i class="ph ph-trash"></i></button>
                        </span>
                    </div>
                }
            }
        </div>

        @if (VisibleList.Count < FilteredList.Count)
        {
            <button type="button" class="btn btn-secondary" style="align-self:center;margin-top:4px" @onclick="ShowMore">Показать ещё</button>
        }
    }
}

@code {
    private List<Account> _accounts = new();
    private List<Category> _categories = new();
    private List<Transaction> _transactions = new();
    private HashSet<Guid> _pendingIds = new();
    private bool _loaded;

    private string _search = string.Empty;
    private TransactionType? _typeFilter;
    private Guid? _accountFilter;
    private (int Year, int Month)? _monthFilter;
    private int _visibleCount = 20;

    private string _accountFilterValue
    {
        get => _accountFilter?.ToString() ?? string.Empty;
        set { _accountFilter = Guid.TryParse(value, out var id) ? id : null; _visibleCount = 20; }
    }

    private string _monthFilterValue
    {
        get => _monthFilter is { } m ? $"{m.Year}-{m.Month}" : string.Empty;
        set
        {
            _visibleCount = 20;
            if (string.IsNullOrEmpty(value))
            {
                _monthFilter = null;
                return;
            }

            var parts = value.Split('-');
            _monthFilter = (int.Parse(parts[0]), int.Parse(parts[1]));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        DialogService.Saved += OnSaved;
        await LoadAsync();
    }

    private void OnSaved() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        _accounts = await AccountService.GetAllAsync();
        _categories = await CategoryService.GetAllAsync();
        _transactions = await TransactionService.GetAllAsync();
        var outboxEntries = await Outbox.GetAllAsync();
        _pendingIds = outboxEntries.Where(e => e.EntityStore == "transactions").Select(e => e.EntityId).ToHashSet();
        _loaded = true;
    }

    private void SetTypeFilter(TransactionType? type)
    {
        _typeFilter = type;
        _visibleCount = 20;
    }

    private void ShowMore() => _visibleCount += 20;

    private List<Transaction> FilteredList => _transactions
        .Where(t => _typeFilter is null || t.Type == _typeFilter)
        .Where(t => _accountFilter is null || t.AccountId == _accountFilter)
        .Where(t => _monthFilter is null || (t.Date.Year == _monthFilter.Value.Year && t.Date.Month == _monthFilter.Value.Month))
        .Where(MatchesSearch)
        .OrderByDescending(t => t.Date).ThenByDescending(t => t.CreatedAt)
        .ToList();

    private List<Transaction> VisibleList => FilteredList.Take(_visibleCount).ToList();

    private decimal FilteredTotal => FilteredList.Sum(t => t.Type == TransactionType.Income ? t.Amount : -t.Amount);

    private decimal DaySignedTotal(IEnumerable<Transaction> day) => day.Sum(t => t.Type == TransactionType.Income ? t.Amount : -t.Amount);

    private bool MatchesSearch(Transaction t)
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }

        return (t.Note?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || CategoryName(t.CategoryId).Contains(_search, StringComparison.OrdinalIgnoreCase);
    }

    private IEnumerable<(string Key, string Label)> AvailableMonths => _transactions
        .Select(t => (t.Date.Year, t.Date.Month))
        .Distinct()
        .OrderByDescending(m => m.Year).ThenByDescending(m => m.Month)
        .Select(m => ($"{m.Year}-{m.Month}", $"{ToUpperFirst(Format.MonthName(m.Month))} {m.Year}"));

    private bool IsPending(Guid id) => _pendingIds.Contains(id);

    private string AccountName(Guid id) => _accounts.FirstOrDefault(a => a.Id == id)?.Name ?? "?";
    private string CategoryName(Guid id) => _categories.FirstOrDefault(c => c.Id == id)?.Name ?? "?";
    private Category? CategoryOf(Transaction t) => _categories.FirstOrDefault(c => c.Id == t.CategoryId);
    private string TransactionTitle(Transaction t) => string.IsNullOrWhiteSpace(t.Note) ? CategoryName(t.CategoryId) : t.Note;

    private static string ToUpperFirst(string value) => value.Length == 0 ? value : char.ToUpperInvariant(value[0]) + value[1..];

    private async Task DeleteAsync(Guid id)
    {
        await TransactionService.DeleteAsync(id);
        await LoadAsync();
    }

    public void Dispose()
    {
        DialogService.Saved -= OnSaved;
    }
}
