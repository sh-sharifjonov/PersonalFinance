@page "/transactions"
@attribute [Authorize]
@using PersonalFinance.Client.Services
@using PersonalFinance.Domain.Entities
@using PersonalFinance.Domain.Enums
@inject LocalTransactionService TransactionService
@inject LocalAccountService AccountService
@inject LocalCategoryService CategoryService

<PageTitle>Transactions</PageTitle>

<h1 class="h3 mb-3">Transactions</h1>

@if (_transactions is not null && _transactions.Count > 0)
{
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="card summary-card">
                <div class="card-body">
                    <div class="text-muted small">Income</div>
                    <div class="value amount-income">@TotalIncome.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card summary-card">
                <div class="card-body">
                    <div class="text-muted small">Expenses</div>
                    <div class="value amount-expense">@TotalExpense.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card summary-card">
                <div class="card-body">
                    <div class="text-muted small">Net</div>
                    <div class="value @(Net >= 0 ? "amount-income" : "amount-expense")">@Net.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>
}

@if (_accounts is null || _categories is null)
{
    <p class="text-muted">Loading...</p>
}
else if (_accounts.Count == 0)
{
    <div class="empty-state">Add an <a href="accounts">account</a> first.</div>
}
else if (_categories.Count == 0)
{
    <div class="empty-state">Add a <a href="categories">category</a> first.</div>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h6 text-uppercase text-muted mb-3">@(_editingId is null ? "Add transaction" : "Edit transaction")</h2>
            <EditForm Model="_formModel" OnValidSubmit="SaveTransactionAsync">
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Account</label>
                        <select class="form-select" @bind="_formModel.AccountId">
                            @foreach (var account in _accounts)
                            {
                                <option value="@account.Id">@account.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Category</label>
                        <select class="form-select" @bind="_formModel.CategoryId">
                            @foreach (var category in _categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Type</label>
                        <select class="form-select" @bind="_formModel.Type">
                            <option value="@TransactionType.Expense">Expense</option>
                            <option value="@TransactionType.Income">Income</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Amount</label>
                        <input type="number" step="0.01" class="form-control" @bind="_formModel.Amount" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Date</label>
                        <input type="date" class="form-control" @bind="_formModel.Date" />
                    </div>
                    <div class="col-md-10">
                        <label class="form-label">Note</label>
                        <input class="form-control" @bind="_formModel.Note" placeholder="Optional" />
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-primary">@(_editingId is null ? "Add" : "Save")</button>
                    </div>
                </div>
                @if (_editingId is not null)
                {
                    <button type="button" class="btn btn-link btn-sm mt-2 p-0" @onclick="CancelEdit">Cancel edit</button>
                }
            </EditForm>
        </div>
    </div>
}

@if (_transactions is null)
{
    <p class="text-muted">Loading...</p>
}
else if (_transactions.Count == 0)
{
    <div class="empty-state">No transactions yet.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Account</th>
                        <th>Category</th>
                        <th>Type</th>
                        <th class="text-end">Amount</th>
                        <th>Note</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transaction in _transactions)
                    {
                        <tr>
                            <td>@transaction.Date.ToString("yyyy-MM-dd")</td>
                            <td>@AccountName(transaction.AccountId)</td>
                            <td>@CategoryName(transaction.CategoryId)</td>
                            <td>
                                <span class="badge @(transaction.Type == TransactionType.Income ? "bg-success" : "bg-danger")">
                                    @transaction.Type
                                </span>
                            </td>
                            <td class="text-end @(transaction.Type == TransactionType.Income ? "amount-income" : "amount-expense")">
                                @(transaction.Type == TransactionType.Income ? "+" : "-")@transaction.Amount.ToString("N2")
                            </td>
                            <td class="text-muted">@transaction.Note</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => StartEdit(transaction)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteTransactionAsync(transaction.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<Account>? _accounts;
    private List<Category>? _categories;
    private List<Transaction>? _transactions;
    private Guid? _editingId;
    private TransactionFormModel _formModel = new();

    private decimal TotalIncome => _transactions?.Where(t => t.Type == TransactionType.Income).Sum(t => t.Amount) ?? 0;
    private decimal TotalExpense => _transactions?.Where(t => t.Type == TransactionType.Expense).Sum(t => t.Amount) ?? 0;
    private decimal Net => TotalIncome - TotalExpense;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _accounts = await AccountService.GetAllAsync();
        _categories = await CategoryService.GetAllAsync();
        _transactions = await TransactionService.GetAllAsync();

        if (_editingId is null)
        {
            if (_formModel.AccountId == Guid.Empty && _accounts.Count > 0)
            {
                _formModel.AccountId = _accounts[0].Id;
            }

            if (_formModel.CategoryId == Guid.Empty && _categories.Count > 0)
            {
                _formModel.CategoryId = _categories[0].Id;
            }
        }
    }

    private void StartEdit(Transaction transaction)
    {
        _editingId = transaction.Id;
        _formModel = new TransactionFormModel
        {
            AccountId = transaction.AccountId,
            CategoryId = transaction.CategoryId,
            Type = transaction.Type,
            Amount = transaction.Amount,
            Date = transaction.Date,
            Note = transaction.Note
        };
    }

    private void CancelEdit()
    {
        _editingId = null;
        _formModel = new TransactionFormModel
        {
            AccountId = _accounts?.FirstOrDefault()?.Id ?? Guid.Empty,
            CategoryId = _categories?.FirstOrDefault()?.Id ?? Guid.Empty
        };
    }

    private async Task SaveTransactionAsync()
    {
        if (_editingId is { } id)
        {
            await TransactionService.UpdateAsync(
                id,
                _formModel.AccountId,
                _formModel.CategoryId,
                _formModel.Type,
                _formModel.Amount,
                _formModel.Date,
                string.IsNullOrWhiteSpace(_formModel.Note) ? null : _formModel.Note);
        }
        else
        {
            await TransactionService.CreateAsync(
                _formModel.AccountId,
                _formModel.CategoryId,
                _formModel.Type,
                _formModel.Amount,
                _formModel.Date,
                string.IsNullOrWhiteSpace(_formModel.Note) ? null : _formModel.Note);
        }

        CancelEdit();
        await LoadAsync();
    }

    private async Task DeleteTransactionAsync(Guid id)
    {
        if (_editingId == id)
        {
            CancelEdit();
        }

        await TransactionService.DeleteAsync(id);
        await LoadAsync();
    }

    private string AccountName(Guid id) => _accounts?.FirstOrDefault(a => a.Id == id)?.Name ?? "?";

    private string CategoryName(Guid id) => _categories?.FirstOrDefault(c => c.Id == id)?.Name ?? "?";

    private class TransactionFormModel
    {
        public Guid AccountId { get; set; }
        public Guid CategoryId { get; set; }
        public TransactionType Type { get; set; } = TransactionType.Expense;
        public decimal Amount { get; set; }
        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public string? Note { get; set; }
    }
}
