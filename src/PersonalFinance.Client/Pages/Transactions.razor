@page "/transactions"
@attribute [Authorize]
@implements IDisposable
@inject FinanceDataService DataService
@inject AppState AppState

<PageTitle>Операции · Финансы</PageTitle>

<PageTop Title="Операции">
    <button type="button" class="btn btn--primary pf-hide-mobile" @onclick="() => AppState.OpenTransactionEditor()"><Icon Name="plus" />Новая операция</button>
</PageTop>

<div class="pf-body">
    @if (_data is null)
    {
        <div class="pf-empty-inline">Загрузка…</div>
    }
    else if (_data.Transactions.Count == 0)
    {
        <EmptyState Title="Пока ни одной операции" Text="Добавьте первый расход или доход — он сохранится на устройстве даже без интернета.">
            <button type="button" class="btn btn--primary" @onclick="() => AppState.OpenTransactionEditor()"><Icon Name="plus" />Новая операция</button>
        </EmptyState>
    }
    else
    {
        <div class="card">
            <div class="pf-filters">
                <div class="input-icon">
                    <span class="ico"><Icon Name="search" Class="@null" /></span>
                    <input class="input" type="search" placeholder="Поиск по заметкам" aria-label="Поиск"
                           @bind="_search" @bind:event="oninput" @bind:after="ResetPaging" />
                </div>
                <div class="tabs pills bare" role="tablist">
                    <span class="tab @(_type is null ? "is-active" : null)" role="tab" @onclick="() => SetType(null)">Все</span>
                    <span class="tab @(_type == TransactionType.Expense ? "is-active" : null)" role="tab" @onclick="() => SetType(TransactionType.Expense)">Расходы</span>
                    <span class="tab @(_type == TransactionType.Income ? "is-active" : null)" role="tab" @onclick="() => SetType(TransactionType.Income)">Доходы</span>
                </div>
                <select class="select" aria-label="Счёт" @bind="_accountId" @bind:after="ResetPaging">
                    <option value="@Guid.Empty">Все счета</option>
                    @foreach (var account in _data.Accounts)
                    {
                        <option value="@account.Id">@account.Name</option>
                    }
                </select>
                <div class="pf-month">
                    <button type="button" class="btn btn--ghost" aria-label="Предыдущий месяц" @onclick="() => ShiftMonth(-1)"><Icon Name="chev-left" /></button>
                    <button type="button" class="btn btn--ghost pf-month-label" title="Показать все месяцы" @onclick="ToggleAllTime">
                        <Icon Name="cal" />@(_month is { } m ? Fmt.MonthYear(m.Year, m.Month) : "Всё время")
                    </button>
                    <button type="button" class="btn btn--ghost" aria-label="Следующий месяц" @onclick="() => ShiftMonth(1)"><Icon Name="chev-right" /></button>
                </div>
                <span class="pf-filters-summary">
                    @Fmt.Operations(_filtered.Count) ·
                    <span class="pf-amt" style="color:var(--primary)">@Fmt.Delta(_filteredNet, _data.Currency)</span>
                </span>
            </div>

            @if (_filtered.Count == 0)
            {
                <div class="pf-empty-inline">Под фильтр ничего не попало.</div>
            }
            else
            {
                @foreach (var day in _filtered.Take(_visible).GroupBy(t => t.Date))
                {
                    var dayNet = day.Sum(FinanceSnapshot.SignedAmount);
                    <div class="pf-day">
                        <span class="eyebrow">@Fmt.DayHeading(day.Key, _today)</span>
                        <span class="pf-amt @(dayNet >= 0 ? "pos" : "muted")">@Fmt.Delta(dayNet, _data.Currency)</span>
                    </div>
                    @foreach (var transaction in day)
                    {
                        <TransactionRow Transaction="transaction" Data="_data" ShowPending="true" />
                    }
                }

                @if (_filtered.Count > _visible)
                {
                    <button type="button" class="btn btn--ghost" style="align-self:center;margin-top:14px" @onclick="() => _visible += PageSize">Показать ещё</button>
                }
            }
        </div>
    }
</div>

@code {
    private const int PageSize = 50;

    private FinanceSnapshot? _data;
    private DateOnly _today;
    private string? _search;
    private TransactionType? _type;
    private Guid _accountId = Guid.Empty;
    private DateOnly? _month;
    private int _visible = PageSize;

    private List<Transaction> _filtered = new();
    private decimal _filteredNet;

    protected override async Task OnInitializedAsync()
    {
        AppState.DataChanged += OnDataChanged;
        _today = FinanceSnapshot.Today;
        _month = new DateOnly(_today.Year, _today.Month, 1);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _data = await DataService.LoadAsync();
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (_data is null)
        {
            return;
        }

        IEnumerable<Transaction> query = _data.Transactions;

        if (_month is { } month)
        {
            query = query.Where(t => t.Date.Year == month.Year && t.Date.Month == month.Month);
        }

        if (_type is { } type)
        {
            query = query.Where(t => t.Type == type);
        }

        if (_accountId != Guid.Empty)
        {
            query = query.Where(t => t.AccountId == _accountId);
        }

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var term = _search.Trim();
            query = query.Where(t =>
                (t.Note?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (_data.CategoryOf(t)?.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        _filtered = query.ToList();
        _filteredNet = _filtered.Sum(FinanceSnapshot.SignedAmount);
    }

    private void ResetPaging()
    {
        _visible = PageSize;
        ApplyFilters();
    }

    private void SetType(TransactionType? type)
    {
        _type = type;
        ResetPaging();
    }

    private void ShiftMonth(int delta)
    {
        var current = _month ?? new DateOnly(_today.Year, _today.Month, 1);
        _month = current.AddMonths(delta);
        ResetPaging();
    }

    private void ToggleAllTime()
    {
        _month = _month is null ? new DateOnly(_today.Year, _today.Month, 1) : null;
        ResetPaging();
    }

    private void OnDataChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => AppState.DataChanged -= OnDataChanged;
}
