@page "/transactions"
@using PersonalFinance.Client.Services
@using PersonalFinance.Domain.Entities
@using PersonalFinance.Domain.Enums
@inject LocalTransactionService TransactionService
@inject LocalAccountService AccountService
@inject LocalCategoryService CategoryService

<PageTitle>Transactions</PageTitle>

<h1>Transactions</h1>

@if (_accounts is null || _categories is null)
{
    <p>Loading...</p>
}
else if (_accounts.Count == 0)
{
    <p>Add an <a href="accounts">account</a> first.</p>
}
else if (_categories.Count == 0)
{
    <p>Add a <a href="categories">category</a> first.</p>
}
else
{
    <EditForm Model="_formModel" OnValidSubmit="SaveTransactionAsync">
        <select @bind="_formModel.AccountId">
            @foreach (var account in _accounts)
            {
                <option value="@account.Id">@account.Name</option>
            }
        </select>
        <select @bind="_formModel.CategoryId">
            @foreach (var category in _categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
        <select @bind="_formModel.Type">
            <option value="@TransactionType.Expense">Expense</option>
            <option value="@TransactionType.Income">Income</option>
        </select>
        <input type="number" step="0.01" @bind="_formModel.Amount" placeholder="Amount" />
        <input type="date" @bind="_formModel.Date" />
        <input @bind="_formModel.Note" placeholder="Note" />
        <button type="submit">@(_editingId is null ? "Add transaction" : "Save changes")</button>
        @if (_editingId is not null)
        {
            <button type="button" @onclick="CancelEdit">Cancel</button>
        }
    </EditForm>
}

@if (_transactions is null)
{
    <p>Loading...</p>
}
else if (_transactions.Count == 0)
{
    <p>No transactions yet.</p>
}
else
{
    <ul>
        @foreach (var transaction in _transactions)
        {
            <li>
                @transaction.Date.ToString("yyyy-MM-dd") &mdash; @AccountName(transaction.AccountId) / @CategoryName(transaction.CategoryId) &mdash; @transaction.Type @transaction.Amount
                @if (!string.IsNullOrWhiteSpace(transaction.Note))
                {
                    <em>(@transaction.Note)</em>
                }
                <button @onclick="() => StartEdit(transaction)">Edit</button>
                <button @onclick="() => DeleteTransactionAsync(transaction.Id)">Delete</button>
            </li>
        }
    </ul>
}

@code {
    private List<Account>? _accounts;
    private List<Category>? _categories;
    private List<Transaction>? _transactions;
    private Guid? _editingId;
    private TransactionFormModel _formModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _accounts = await AccountService.GetAllAsync();
        _categories = await CategoryService.GetAllAsync();
        _transactions = await TransactionService.GetAllAsync();

        if (_editingId is null)
        {
            if (_formModel.AccountId == Guid.Empty && _accounts.Count > 0)
            {
                _formModel.AccountId = _accounts[0].Id;
            }

            if (_formModel.CategoryId == Guid.Empty && _categories.Count > 0)
            {
                _formModel.CategoryId = _categories[0].Id;
            }
        }
    }

    private void StartEdit(Transaction transaction)
    {
        _editingId = transaction.Id;
        _formModel = new TransactionFormModel
        {
            AccountId = transaction.AccountId,
            CategoryId = transaction.CategoryId,
            Type = transaction.Type,
            Amount = transaction.Amount,
            Date = transaction.Date,
            Note = transaction.Note
        };
    }

    private void CancelEdit()
    {
        _editingId = null;
        _formModel = new TransactionFormModel
        {
            AccountId = _accounts?.FirstOrDefault()?.Id ?? Guid.Empty,
            CategoryId = _categories?.FirstOrDefault()?.Id ?? Guid.Empty
        };
    }

    private async Task SaveTransactionAsync()
    {
        if (_editingId is { } id)
        {
            await TransactionService.UpdateAsync(
                id,
                _formModel.AccountId,
                _formModel.CategoryId,
                _formModel.Type,
                _formModel.Amount,
                _formModel.Date,
                string.IsNullOrWhiteSpace(_formModel.Note) ? null : _formModel.Note);
        }
        else
        {
            await TransactionService.CreateAsync(
                _formModel.AccountId,
                _formModel.CategoryId,
                _formModel.Type,
                _formModel.Amount,
                _formModel.Date,
                string.IsNullOrWhiteSpace(_formModel.Note) ? null : _formModel.Note);
        }

        CancelEdit();
        await LoadAsync();
    }

    private async Task DeleteTransactionAsync(Guid id)
    {
        if (_editingId == id)
        {
            CancelEdit();
        }

        await TransactionService.DeleteAsync(id);
        await LoadAsync();
    }

    private string AccountName(Guid id) => _accounts?.FirstOrDefault(a => a.Id == id)?.Name ?? "?";

    private string CategoryName(Guid id) => _categories?.FirstOrDefault(c => c.Id == id)?.Name ?? "?";

    private class TransactionFormModel
    {
        public Guid AccountId { get; set; }
        public Guid CategoryId { get; set; }
        public TransactionType Type { get; set; } = TransactionType.Expense;
        public decimal Amount { get; set; }
        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public string? Note { get; set; }
    }
}
