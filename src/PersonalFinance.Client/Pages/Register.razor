@page "/register"
@using PersonalFinance.Client.Auth
@using PersonalFinance.Client.Services
@using PersonalFinance.Client.Sync
@using PersonalFinance.Domain.Enums
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject SyncService SyncService
@inject LocalAccountService AccountService
@inject LocalCategoryService CategoryService
@inject NavigationManager Navigation

<PageTitle>Регистрация</PageTitle>

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-brand"><span class="brand-mark">PF</span>Финансы</div>
        <h3>Регистрация</h3>
        <p class="text-muted" style="font-size:13px;margin-bottom:var(--space-6)">
            Первый счёт и базовые категории создадутся автоматически.
        </p>

        <EditForm Model="_model" OnValidSubmit="RegisterAsync">
            <div class="field" style="margin-bottom:14px">
                <label>Имя</label>
                <input class="input" @bind="_model.DisplayName" required />
            </div>
            <div class="field" style="margin-bottom:14px">
                <label>Email</label>
                <input class="input" type="email" @bind="_model.Email" placeholder="you@mail.uz" required />
            </div>
            <div class="field">
                <label>Пароль</label>
                <input class="input" type="password" @bind="_model.Password" minlength="8" placeholder="Минимум 8 символов" required />
            </div>
            <div class="text-muted" style="font-size:11.5px;margin-top:7px">Пароль хранится только в виде хэша.</div>

            @if (_error is not null)
            {
                <div class="validation-message" style="margin-top:10px">@_error</div>
            }

            <button type="submit" class="btn btn-primary btn-block" style="margin-top:22px;padding-block:9px" disabled="@_isBusy">
                @if (_isBusy)
                {
                    <i class="ph ph-spinner spin"></i>
                }
                Создать аккаунт
            </button>
        </EditForm>

        <div style="font-size:12.5px;color:color-mix(in srgb, var(--color-text) 55%, transparent);margin-top:18px;text-align:center">
            Уже есть аккаунт? <a href="login">Войти</a>
        </div>
    </div>
</div>

@code {
    private readonly RegisterModel _model = new();
    private string? _error;
    private bool _isBusy;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated ?? false)
        {
            Navigation.NavigateTo("/dashboard");
        }
    }

    private async Task RegisterAsync()
    {
        _isBusy = true;
        _error = null;

        var result = await AuthService.RegisterAsync(_model.Email, _model.Password, _model.DisplayName);

        if (!result.Success)
        {
            _error = result.Error;
            _isBusy = false;
            return;
        }

        await SeedDefaultsAsync();
        _ = SyncService.SyncAsync();
        Navigation.NavigateTo("/dashboard");
    }

    // The copy above promises a starter account and categories — the API has no seeding
    // of its own, so a fresh sign-up creates them locally before landing on the dashboard.
    private async Task SeedDefaultsAsync()
    {
        await AccountService.CreateAsync("Наличные", "USD", 0);

        var expenseCategories = new (string Name, string Icon)[]
        {
            ("Жильё", "house"),
            ("Продукты", "shopping-cart"),
            ("Кафе", "coffee"),
            ("Транспорт", "bus"),
            ("Связь", "wifi-high"),
            ("Здоровье", "heartbeat"),
            ("Прочее", "dots-three-circle"),
        };
        foreach (var (name, icon) in expenseCategories)
        {
            await CategoryService.CreateAsync(name, CategoryType.Expense, icon, null);
        }

        var incomeCategories = new (string Name, string Icon)[]
        {
            ("Зарплата", "briefcase"),
            ("Фриланс", "laptop"),
        };
        foreach (var (name, icon) in incomeCategories)
        {
            await CategoryService.CreateAsync(name, CategoryType.Income, icon, null);
        }
    }

    private class RegisterModel
    {
        public string DisplayName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
