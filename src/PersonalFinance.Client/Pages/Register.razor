@page "/register"
@using PersonalFinance.Client.Auth
@using PersonalFinance.Client.Sync
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject SyncService SyncService
@inject LocalAccountService AccountService
@inject LocalCategoryService CategoryService
@inject NavigationManager Navigation

<PageTitle>Регистрация · Финансы</PageTitle>

<div class="card pf-auth-card">
    <div class="pf-auth-brand">
        <span class="brand-logo"><svg viewBox="0 0 36 36"><use href="#i-logo"></use></svg></span>
        <span class="brand-name">Финансы</span>
    </div>
    <div>
        <h1 class="pf-h" style="font-size:24px" tabindex="-1">Регистрация</h1>
        <div class="field-help" style="font-size:13px;margin-top:4px">Первый счёт и базовые категории создадутся автоматически.</div>
    </div>

    <EditForm Model="_model" OnSubmit="RegisterAsync" style="display:flex;flex-direction:column;gap:16px">
        <div class="field">
            <label class="field-label" for="displayName">Имя</label>
            <input id="displayName" class="input" autocomplete="name" required @bind="_model.DisplayName" />
        </div>
        <div class="field">
            <label class="field-label" for="email">Email <span class="req">*</span></label>
            <input id="email" class="input" type="email" autocomplete="email" required @bind="_model.Email" />
        </div>
        <div class="field">
            <label class="field-label" for="password">Пароль <span class="req">*</span></label>
            <input id="password" class="input @(_passwordError is null ? null : "is-invalid")" type="password" autocomplete="new-password"
                   placeholder="Минимум 8 символов" minlength="8" required @bind="_model.Password" />
            @if (_passwordError is not null)
            {
                <span class="field-error">@_passwordError</span>
            }
        </div>

        @if (_error is not null)
        {
            <div class="pf-alert" role="alert"><Icon Name="alert" />@_error</div>
        }

        <button type="submit" class="btn btn--primary btn--block" style="padding:11px" disabled="@_isBusy">
            @(_isBusy ? "Создаём…" : "Создать аккаунт")
        </button>
    </EditForm>

    <div class="pf-auth-foot">Уже есть аккаунт? <a href="login">Войти</a></div>
</div>

@code {
    private static readonly (string Name, CategoryType Type, string Icon)[] StarterCategories =
    {
        ("Продукты", CategoryType.Expense, "cart"),
        ("Транспорт", CategoryType.Expense, "bus"),
        ("Кафе", CategoryType.Expense, "cup"),
        ("Жильё", CategoryType.Expense, "home"),
        ("Связь", CategoryType.Expense, "wifi"),
        ("Здоровье", CategoryType.Expense, "heart"),
        ("Прочее", CategoryType.Expense, "dots"),
        ("Зарплата", CategoryType.Income, "case"),
        ("Фриланс", CategoryType.Income, "laptop")
    };

    private readonly RegisterModel _model = new();
    private string? _error;
    private string? _passwordError;
    private bool _isBusy;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated ?? false)
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task RegisterAsync()
    {
        _passwordError = _model.Password.Length < 8 ? "Минимум 8 символов" : null;
        if (_passwordError is not null)
        {
            return;
        }

        _isBusy = true;
        _error = null;

        LoginResult result;
        try
        {
            result = await AuthService.RegisterAsync(_model.Email, _model.Password, _model.DisplayName);
        }
        catch (HttpRequestException)
        {
            result = new LoginResult(false, "Сервер недоступен. Для регистрации нужна сеть.");
        }

        if (!result.Success)
        {
            _error = result.Error;
            _isBusy = false;
            return;
        }

        await SeedStarterDataAsync();
        _ = SyncService.SyncAsync();
        Navigation.NavigateTo("/");
    }

    // Created locally like any other edit (client-side Guids + outbox), so they reach the
    // server through the normal push. Skipped if this device already has data.
    private async Task SeedStarterDataAsync()
    {
        if ((await AccountService.GetAllAsync()).Count == 0)
        {
            await AccountService.CreateAsync("Основной счёт", "USD", 0);
        }

        if ((await CategoryService.GetAllAsync()).Count == 0)
        {
            foreach (var (name, type, icon) in StarterCategories)
            {
                await CategoryService.CreateAsync(name, type, icon, Visuals.ToneFor(icon));
            }
        }
    }

    private class RegisterModel
    {
        public string DisplayName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
