@page "/register"
@using PersonalFinance.Client.Auth
@using PersonalFinance.Client.Sync
@inject AuthService AuthService
@inject SyncService SyncService
@inject NavigationManager Navigation

<PageTitle>Register</PageTitle>

<h1>Register</h1>

<EditForm Model="_model" OnValidSubmit="RegisterAsync">
    <input @bind="_model.DisplayName" placeholder="Name" />
    <input @bind="_model.Email" placeholder="Email" type="email" />
    <input @bind="_model.Password" placeholder="Password (min 8 characters)" type="password" />
    <button type="submit" disabled="@_isBusy">Register</button>
</EditForm>

@if (_error is not null)
{
    <p style="color:red">@_error</p>
}

<p><a href="login">Already have an account? Log in</a></p>

@code {
    private readonly RegisterModel _model = new();
    private string? _error;
    private bool _isBusy;

    private async Task RegisterAsync()
    {
        _isBusy = true;
        _error = null;

        var result = await AuthService.RegisterAsync(_model.Email, _model.Password, _model.DisplayName);

        if (!result.Success)
        {
            _error = result.Error;
            _isBusy = false;
            return;
        }

        _ = SyncService.SyncAsync();
        Navigation.NavigateTo("/accounts");
    }

    private class RegisterModel
    {
        public string DisplayName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
