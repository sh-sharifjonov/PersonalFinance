@page "/categories"
@attribute [Authorize]
@using PersonalFinance.Client.Services
@using PersonalFinance.Domain.Entities
@using PersonalFinance.Domain.Enums
@inject LocalCategoryService CategoryService

<PageTitle>Categories</PageTitle>

<h1 class="h3 mb-3">Categories</h1>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h6 text-uppercase text-muted mb-3">@(_editingId is null ? "Add category" : "Edit category")</h2>
        <EditForm Model="_formModel" OnValidSubmit="SaveCategoryAsync">
            <div class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Name</label>
                    <input class="form-control" @bind="_formModel.Name" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Type</label>
                    <select class="form-select" @bind="_formModel.Type">
                        <option value="@CategoryType.Expense">Expense</option>
                        <option value="@CategoryType.Income">Income</option>
                    </select>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">@(_editingId is null ? "Add" : "Save")</button>
                </div>
            </div>
            @if (_editingId is not null)
            {
                <button type="button" class="btn btn-link btn-sm mt-2 p-0" @onclick="CancelEdit">Cancel edit</button>
            }
        </EditForm>
    </div>
</div>

@if (_categories is null)
{
    <p class="text-muted">Loading...</p>
}
else if (_categories.Count == 0)
{
    <div class="empty-state">No categories yet. Add your first one above.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in _categories)
                    {
                        <tr>
                            <td>@category.Name</td>
                            <td>
                                <span class="badge @(category.Type == CategoryType.Income ? "bg-success" : "bg-danger")">
                                    @category.Type
                                </span>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => StartEdit(category)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCategoryAsync(category.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<Category>? _categories;
    private Guid? _editingId;
    private CategoryFormModel _formModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _categories = await CategoryService.GetAllAsync();
    }

    private void StartEdit(Category category)
    {
        _editingId = category.Id;
        _formModel = new CategoryFormModel
        {
            Name = category.Name,
            Type = category.Type,
            Icon = category.Icon,
            Color = category.Color
        };
    }

    private void CancelEdit()
    {
        _editingId = null;
        _formModel = new CategoryFormModel();
    }

    private async Task SaveCategoryAsync()
    {
        if (_editingId is { } id)
        {
            await CategoryService.UpdateAsync(id, _formModel.Name, _formModel.Type, _formModel.Icon, _formModel.Color);
        }
        else
        {
            await CategoryService.CreateAsync(_formModel.Name, _formModel.Type, _formModel.Icon, _formModel.Color);
        }

        CancelEdit();
        await LoadAsync();
    }

    private async Task DeleteCategoryAsync(Guid id)
    {
        if (_editingId == id)
        {
            CancelEdit();
        }

        await CategoryService.DeleteAsync(id);
        await LoadAsync();
    }

    private class CategoryFormModel
    {
        public string Name { get; set; } = string.Empty;
        public CategoryType Type { get; set; } = CategoryType.Expense;
        public string? Icon { get; set; }
        public string? Color { get; set; }
    }
}
