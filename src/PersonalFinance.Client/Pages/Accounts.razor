@page "/accounts"
@using PersonalFinance.Client.Services
@using PersonalFinance.Domain.Entities
@inject LocalAccountService AccountService

<PageTitle>Accounts</PageTitle>

<h1>Accounts</h1>

<EditForm Model="_formModel" OnValidSubmit="SaveAccountAsync">
    <input @bind="_formModel.Name" placeholder="Name" />
    <input @bind="_formModel.Currency" placeholder="Currency" />
    <input type="number" step="0.01" @bind="_formModel.InitialBalance" />
    <button type="submit">@(_editingId is null ? "Add account" : "Save changes")</button>
    @if (_editingId is not null)
    {
        <button type="button" @onclick="CancelEdit">Cancel</button>
    }
</EditForm>

@if (_accounts is null)
{
    <p>Loading...</p>
}
else if (_accounts.Count == 0)
{
    <p>No accounts yet.</p>
}
else
{
    <ul>
        @foreach (var account in _accounts)
        {
            <li>
                @account.Name (@account.Currency) &mdash; @account.InitialBalance
                <button @onclick="() => StartEdit(account)">Edit</button>
                <button @onclick="() => DeleteAccountAsync(account.Id)">Delete</button>
            </li>
        }
    </ul>
}

@code {
    private List<Account>? _accounts;
    private Guid? _editingId;
    private AccountFormModel _formModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _accounts = await AccountService.GetAllAsync();
    }

    private void StartEdit(Account account)
    {
        _editingId = account.Id;
        _formModel = new AccountFormModel
        {
            Name = account.Name,
            Currency = account.Currency,
            InitialBalance = account.InitialBalance
        };
    }

    private void CancelEdit()
    {
        _editingId = null;
        _formModel = new AccountFormModel();
    }

    private async Task SaveAccountAsync()
    {
        if (_editingId is { } id)
        {
            await AccountService.UpdateAsync(id, _formModel.Name, _formModel.Currency, _formModel.InitialBalance);
        }
        else
        {
            await AccountService.CreateAsync(_formModel.Name, _formModel.Currency, _formModel.InitialBalance);
        }

        CancelEdit();
        await LoadAsync();
    }

    private async Task DeleteAccountAsync(Guid id)
    {
        if (_editingId == id)
        {
            CancelEdit();
        }

        await AccountService.DeleteAsync(id);
        await LoadAsync();
    }

    private class AccountFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Currency { get; set; } = "USD";
        public decimal InitialBalance { get; set; }
    }
}
