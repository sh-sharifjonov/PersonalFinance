@page "/"
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Финансы</PageTitle>

@if (_checked && !_isAuthenticated)
{
    <div class="hero">
        <div class="auth-brand" style="margin-bottom:var(--space-4)"><span class="brand-mark">PF</span>Финансы</div>
        <h1>Держите деньги под контролем</h1>
        <p class="text-muted">
            Офлайн-трекер счетов, категорий и операций. Всё работает без подключения
            и синхронизируется автоматически, когда появится сеть.
        </p>
        <div style="display:flex;gap:10px;margin-top:var(--space-3)">
            <a class="btn btn-primary" href="register">Начать</a>
            <a class="btn btn-secondary" href="login">Войти</a>
        </div>
    </div>
}

@code {
    private bool _checked;
    private bool _isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = state.User.Identity?.IsAuthenticated ?? false;
        _checked = true;

        if (_isAuthenticated)
        {
            Navigation.NavigateTo("/dashboard");
        }
    }
}
