@page "/"

<AuthorizeView>
    <Authorized>
        <Overview />
    </Authorized>
    <NotAuthorized>
        <PageTitle>Финансы</PageTitle>
        <div class="card pf-auth-card wide">
            <div class="pf-auth-brand">
                <span class="brand-logo"><svg viewBox="0 0 36 36"><use href="#i-logo"></use></svg></span>
                <span class="brand-name">Финансы</span>
            </div>
            <div>
                <span class="eyebrow" style="display:block;margin-bottom:10px">Personal finance</span>
                <h1 class="pf-h" tabindex="-1">Деньги под контролем</h1>
                <div class="field-help" style="font-size:14px;margin-top:8px">
                    Учёт счетов, категорий и операций. Всё работает без интернета и синхронизируется,
                    как только сеть появится.
                </div>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
                <a class="btn btn--primary" href="register">Начать</a>
                <a class="btn btn--ghost" href="login">Войти</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>
